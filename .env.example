# Plantilla de configuración local.
# Copia este archivo a .env y ajusta los valores.
# Django carga .env automáticamente si existe; el archivo está ignorado por Git.
# No guardes contraseñas reales en este archivo de ejemplo.

DJANGO_SECRET_KEY=cambiar-esta-clave-en-produccion
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
DEMO_MODE=1

# Correo: SIMULADO imprime en consola; SMTP envía de verdad.
# Para Gmail usa una contraseña de aplicación, no la contraseña normal.
EMAIL_MODE=SIMULADO
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Agendamiento Demo <no-reply@demo.cl>

# WhatsApp: SIMULADO no sale de la máquina; CLOUD_API usa Meta.
WHATSAPP_MODE=SIMULADO
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TIMEOUT_SECONDS=10
