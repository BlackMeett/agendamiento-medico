# Variables de ejemplo para la demo local.
# Django no carga este archivo automáticamente: define las variables en PowerShell
# o en el gestor de secretos del entorno que corresponda.
#
# Ejemplo en PowerShell:
#   $env:DJANGO_SECRET_KEY = "una-clave-larga-y-aleatoria"
#   $env:DJANGO_DEBUG = "0"
#   $env:DJANGO_ALLOWED_HOSTS = "agenda.example.org"
#   $env:DEMO_MODE = "0"
#   .\.venv\Scripts\python.exe manage.py runserver

DJANGO_SECRET_KEY=cambiar-esta-clave-en-produccion
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
DEMO_MODE=1
